option(REQUESTMAN_ENABLE_ASAN "Enable AddressSanitizer" OFF)
option(REQUESTMAN_ENABLE_UBSAN "Enable UndefinedBehaviorSanitizer" OFF)
option(REQUESTMAN_ENABLE_TSAN "Enable ThreadSanitizer" OFF)

function(requestman_enable_sanitizers target)
  set(flags "")
  if(REQUESTMAN_ENABLE_ASAN)
    list(APPEND flags -fsanitize=address -fno-omit-frame-pointer)
  endif()
  if(REQUESTMAN_ENABLE_UBSAN)
    list(APPEND flags -fsanitize=undefined -fno-omit-frame-pointer)
  endif()
  if(REQUESTMAN_ENABLE_TSAN)
    list(APPEND flags -fsanitize=thread -fno-omit-frame-pointer)
  endif()
  if(flags)
    target_compile_options(${target} PRIVATE ${flags})
    target_link_options(${target} PRIVATE ${flags})
  endif()
endfunction()
